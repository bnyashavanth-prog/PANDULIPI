[Unit]
Description=Pandulipi Kiosk Backend API
After=network.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/PANDULIPI/apps/api
Environment="HW_MODE=real"
ExecStart=/home/pi/PANDULIPI/venv/bin/uvicorn main:app --host 0.0.0.0 --port 8000
Restart=always

[Install]
WantedBy=multi-user.target
